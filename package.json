{
  "name": "testrepo-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Monorepo with an Express + SQLite CRUD API and a React listing/form frontend.",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev --workspace @testrepo/api",
    "dev:web": "npm run dev --workspace @testrepo/web",
    "build": "npm run build --workspace @testrepo/web",
    "start": "npm run start --workspace @testrepo/api",
    "smoke": "node --disable-warning=ExperimentalWarning scripts/smoke.mjs",
    "test": "node --test --disable-warning=ExperimentalWarning \"apps/api/test/**/*.test.js\"",
    "test:http": "node --test --disable-warning=ExperimentalWarning \"apps/api/test-http/**/*.test.js\"",
    "test:all": "npm run test && npm run test:http",
    "test:agent": "node --test --test-reporter=dot --disable-warning=ExperimentalWarning \"apps/api/test/**/*.test.js\""
  }
}
