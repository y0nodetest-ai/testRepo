# Port the API listens on
PORT=4000

# SQLite file, relative to apps/api. Use :memory: for a throwaway database.
DATABASE_FILE=data/app.sqlite

# Comma-separated browser origins allowed to call the API.
# Leave unset locally (any localhost port is allowed); always set it in deployed environments.
CORS_ORIGINS=http://localhost:5173

# Insert demo rows when the products table is empty
SEED_ON_EMPTY=true
